{
    "Add SSL Cipher Group and Profile (SSL Labs A+ Q3 2026)": {
        "prefix": [
            "add ssl cipher",
            "add ssl profile"
        ],
        "body": [
            "${LINE_COMMENT} Add SSL Cipher Group and SSL Profile (SSL Labs A+ Q3 2026)",
            "${LINE_COMMENT} See more information at https://community.citrix.com/tech-zone/build/tech-papers/networking-tls-best-practices-2026/",
            "add ssl cipher ${1:<cipher_group_name>}",
            "bind ssl cipher ${1} -cipherName TLS1.3-AES256-GCM-SHA384",
            "bind ssl cipher ${1} -cipherName TLS1.3-AES128-GCM-SHA256",
            "bind ssl cipher ${1} -cipherName TLS1.3-CHACHA20-POLY1305-SHA256",
            "bind ssl cipher ${1} -cipherName TLS1.2-ECDHE-ECDSA-AES256-GCM-SHA384",
            "bind ssl cipher ${1} -cipherName TLS1.2-ECDHE-ECDSA-AES128-GCM-SHA256",
            "bind ssl cipher ${1} -cipherName TLS1.2-ECDHE-RSA-AES256-GCM-SHA384",
            "",
            "set ssl parameter -defaultProfile ENABLED",
            "",
            "add ssl profile ${2:<ssl_profile_name>} -tls1 DISABLED -tls11 DISABLED -tls12 ENABLED -tls13 ENABLED -ocspStapling ENABLED -denySSLReneg NONSECURE -HSTS ENABLED -maxage 157680000",
            "unbind ssl profile ${2} -cipherName DEFAULT",
            "bind ssl profile ${2} -cipherName ${1}",
            "set ssl profile ${2} -maxrenegRate 100",
            "",
            "${LINE_COMMENT} X25519_MLKEM768 is bound first for hybrid post-quantum key exchange priority; clients without ML-KEM-768 support fall back to X25519",
            "unbind ssl profile ${2} -eccCurveName ALL",
            "bind ssl profile ${2} -eccCurveName X25519_MLKEM768",
            "bind ssl profile ${2} -eccCurveName X25519",
            "bind ssl profile ${2} -eccCurveName P256",
            "bind ssl profile ${2} -eccCurveName P384",
            "bind ssl profile ${2} -eccCurveName P521"
        ]
    },
    "Bind SSL vServer to Certificate": {
        "prefix": [
            "bind ssl vserver CERTIFICATE"
        ],
        "body": "bind ssl vserver ${1:<name>} -certkeyName ${2:<certkeyPairName>}"
    },
    "Bind SSL vServer to SSL Profile": {
        "prefix": [
            "set ssl vserver PROFILE"
        ],
        "body": [
            "set ssl vserver ${1:<name>} -sslProfile ${2:<sslProfileName>}"
        ]
    }
}